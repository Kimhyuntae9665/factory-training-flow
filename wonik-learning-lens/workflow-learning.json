{
  "id": "WonikLearningV3Local",
  "name": "WONIK 합성 교육계획 · 실제 n8n 입력과 출력",
  "active": false,
  "nodes": [
    {
      "id": "request",
      "name": "합성 요청 접수",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wonik-learning",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "wonik-learning-v3-local"
    },
    {
      "id": "review",
      "name": "교육 요청 검토",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8798/api/learning/review",
        "options": {
          "timeout": 330000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({requestId:$json.body.requestId,selectedWorkerId:$json.body.selectedWorkerId,query:$json.body.query,mode:$json.body.mode,policyScope:$json.body.policyScope}) }}"
      }
    },
    {
      "id": "gate",
      "name": "승인 대기 대상",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "state",
              "leftValue": "={{ $json.state }}",
              "rightValue": "awaiting_approval",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wait",
      "name": "담당자 결정 대기",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        -90
      ],
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "wonik-learning-v3-review",
      "notes": "실행 중 생성한 $execution.resumeUrl에 명시적 JSON {action:approve} 또는 {action:reject}를 POST합니다. 자동 승인 없음. 검수 결정은 합성 테스트 동작입니다.",
      "notesInFlow": true
    },
    {
      "id": "decision",
      "name": "명시적 결정 기록",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -90
      ],
      "parameters": {
        "url": "http://127.0.0.1:8798/api/learning/decision",
        "options": {
          "timeout": 10000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({requestId:$('합성 요청 접수').item.json.body.requestId,action:$json.body.action}) }}"
      }
    },
    {
      "id": "plans",
      "name": "계획 원장 출력",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -90
      ],
      "parameters": {
        "url": "http://127.0.0.1:8798/api/learning/plans",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "csv",
      "name": "CSV 출력",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -90
      ],
      "parameters": {
        "url": "http://127.0.0.1:8798/api/learning/export.csv",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "csv"
            }
          }
        }
      }
    },
    {
      "id": "blocked",
      "name": "차단 결과",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        140
      ],
      "parameters": {},
      "notes": "차단 상태·근거를 출력하고 종료합니다. Wait·결정·원장·CSV를 실행하지 않습니다."
    }
  ],
  "connections": {
